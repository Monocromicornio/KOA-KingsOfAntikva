  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Objective
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: "Os ex\xE9rcitos est\xE3o ocultos por uma n\xE9voa de guerra, o que impede
      que saibamos quem \xE9 quem no lado inimigo. A vantagem \xE9 que eles tamb\xE9m
      n\xE3o conseguem ver nossos soldados. Voc\xEA ver\xE1 o seu ex\xE9rcito normalmente,
      mas os soldados inimigos permanecer\xE3o ocultos."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: "Para vencer esta guerra, precisamos encontrar o tesouro inimigo, que est\xE1
      escondido entre o ex\xE9rcito dele."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
