  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Objective
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: "Os exercitos est\xE3o escondidos por uma nevoa o que impede que n\xF3s
      vejamos quem \xE9 quem. O lado bom \xE9 que o Rei inimigo n\xE3o nos v\xEA
      tamb\xE9m, mas n\xE3o se preocupe, voc\xEA ver\xE1 nosso exercito normalmente,
      s\xF3 n\xE3o conseguir\xE1 ver os inimigos."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: ed3720298f6d432488b5002e31fbe99c, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
  - text: "Nosso objetivo para vencer esta guerra \xE9 encontrar o tesouro do inimigo
      que est\xE1 escondido entre seus soldados.. "
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: ed3720298f6d432488b5002e31fbe99c, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
