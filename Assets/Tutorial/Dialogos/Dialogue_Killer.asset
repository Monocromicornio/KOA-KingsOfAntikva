  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Killer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: The enemy King is just as powerful as I am. That's why I trained a special
      soldier capable of defeating him.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: However, he was trained solely for that mission and is not as effective
      against other soldiers. Use him carefully, and attack only when you are certain
      you have found the enemy King.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
