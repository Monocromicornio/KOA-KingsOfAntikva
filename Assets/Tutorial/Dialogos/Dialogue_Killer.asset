  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Killer
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: "O Rei inimigo \xE9 t\xE3o poderoso quanto eu. Por isso, treinei um soldado
      especial capaz de derrot\xE1-lo."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: "Por\xE9m, ele foi preparado apenas para essa miss\xE3o e n\xE3o \xE9 t\xE3o
      eficiente contra outros soldados. Use-o com cautela e ataque apenas quando
      tiver certeza de que encontrou o Rei inimigo."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
