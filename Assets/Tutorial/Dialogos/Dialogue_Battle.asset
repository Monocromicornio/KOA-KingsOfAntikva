  m_Name: Dialogue_Battle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: To attack, select the soldier who will make the charge. If an enemy is
      within range, on a green tile, simply select the enemy soldier to begin the
      attack.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: 'But remember: in battle, strength determines the winner. The soldier with
      the higher strength wins the fight.'
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
