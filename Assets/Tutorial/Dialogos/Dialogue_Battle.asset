  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Battle
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: "Para atacar, selecione o soldado que far\xE1 a investida. Se um inimigo
      estiver ao alcance, dentro de uma casa verde, basta selecionar o soldado inimigo
      para iniciar o ataque."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: "Mas lembre-se: na batalha, a for\xE7a decide o vencedor. O soldado com
      maior for\xE7a vence o confronto."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
