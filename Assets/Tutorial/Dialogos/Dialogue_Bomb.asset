  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Bomb
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBase
  dialogueInfo:
  - text: "Entre os soldados inimigos, existem armadilhas escondidas: bombas extremamente
      perigosas, capazes de destruir quase qualquer soldado do nosso ex\xE9rcito."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: "Felizmente, contamos com um engenheiro, especialista em desarm\xE1-las.
      Use-o quando suspeitar que uma pe\xE7a inimiga seja uma bomba."
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 0}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
