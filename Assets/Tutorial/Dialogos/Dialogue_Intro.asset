--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 044dd6c09f0854e43941618f557ecf3c, type: 3}
  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: 
  dialogueInfo:
  - text: Hello, Commander. Allow me to introduce myself. I am the one and only true
      King of Antikva.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: That's a lie! I am the true King of Antikva!
    speaker: Red King
    portraitLeft: {fileID: 21300000, guid: 2906de30be64b444ca30b3f21fd15aaf, type: 3}
    portraitRight: {fileID: 21300000, guid: f5f3e3334e305c348977125537e19d7a, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 1
  - text: NO, I AM!
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 3bc63486863378c4c82b5279d8d40cd2, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: NO, I AM!
    speaker: Red King
    portraitLeft: {fileID: 21300000, guid: a8acaa8fae562774fa56221d1219de15, type: 3}
    portraitRight: {fileID: 21300000, guid: f5f3e3334e305c348977125537e19d7a, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 1
    isDoublePortrait: 0
  - text: As you can see, I need your help to defeat this impostor and reclaim my
      throne as the one and only true King of Antikva.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 6d6e4275a8fb0fd47a422823ea588251, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
  - text: I will fight alongside my men on the front lines, so I need you to command
      my troops. Come, I'll show you how.
    speaker: Blue King
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
    isDoublePortrait: 0
