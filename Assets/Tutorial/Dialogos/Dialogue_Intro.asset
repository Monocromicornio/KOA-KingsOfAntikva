  m_Name: Dialogue_Intro
  m_EditorClassIdentifier: 
  dialogueInfo:
  - text: "Ol\xE1 comandante, eu sou o Rei de Antikva"
    speaker: Rei azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
  - text: "Voc\xEA N\xC3O \xE9 o Rei de Antikva, eu quem sou"
    speaker: Rei Vermelho
    portraitLeft: {fileID: 21300000, guid: 2906de30be64b444ca30b3f21fd15aaf, type: 3}
    portraitRight: {fileID: 21300000, guid: f5f3e3334e305c348977125537e19d7a, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 1
  - text: "N\xC3O, SOU EU "
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 3bc63486863378c4c82b5279d8d40cd2, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
  - text: "N\xC3O, SOU EU "
    speaker: Rei Vermelho
    portraitLeft: {fileID: 21300000, guid: a8acaa8fae562774fa56221d1219de15, type: 3}
    portraitRight: {fileID: 21300000, guid: f5f3e3334e305c348977125537e19d7a, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 1
  - text: 'Como voce pode ver preciso de sua ajuda para derrotar este impostor e
      me tornar o unico e verdadeiro rei de Antikva '
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 6d6e4275a8fb0fd47a422823ea588251, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
  - text: Como vou lutar ao lado dos meus homens na linha de frente eu preciso de
      sua ajuda para comandar minhas topas, venha, vou lhe mostrar como
    speaker: Rei Azul
    portraitLeft: {fileID: 21300000, guid: 0ac773d46c729494c8a69bb01d146284, type: 3}
    portraitRight: {fileID: 21300000, guid: 1bc7c1ffe44f3464b825611e3fbc5e4f, type: 3}
    myEvent:
      m_PersistentCalls:
        m_Calls: []
    isRightPortrait: 0
